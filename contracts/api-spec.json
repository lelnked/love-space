{
  "openapi": "3.0.3",
  "info": {
    "title": "love-space API 契约（项目级 living 文件）",
    "description": "登记 OpenSpec change 触及的接口；operation 通过 x-requirement 反链到 openspec specs 的 {domain}/{Requirement 名}。存量未被 change 触及的接口暂不回溯登记。",
    "version": "2026.08.18"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "love-space-admin（JWT 认证，/api/admin/*）"
    },
    {
      "url": "http://localhost:8081",
      "description": "love-space-app（API-key 认证，/api/app/*）"
    }
  ],
  "paths": {
    "/api/admin/merchants": {
      "post": {
        "summary": "创建商户（DTO 新增 recommendReason ≤2000 字，非必填）",
        "x-requirement": "merchant/商户编辑推荐理由"
      }
    },
    "/api/admin/merchants/{id}": {
      "put": {
        "summary": "更新商户（DTO 新增 recommendReason）",
        "x-requirement": "merchant/商户编辑推荐理由"
      }
    },
    "/api/admin/cities": {
      "post": {
        "summary": "创建城市/地图（DTO 新增 editorNote ≤200 字，非必填）",
        "x-requirement": "city/地图编辑说"
      }
    },
    "/api/admin/cities/{id}": {
      "put": {
        "summary": "更新城市/地图（DTO 新增 editorNote）",
        "x-requirement": "city/地图编辑说"
      },
      "delete": {
        "summary": "删除城市/地图（物理删除，无前置校验；提交后异步下架该城市的 CITY Banner 与其下全部商户，只下架不删除）",
        "x-requirement": "city/地图删除"
      }
    },
    "/api/app/cities": {
      "get": {
        "summary": "App 城市列表（响应新增 editorNote）",
        "x-requirement": "city/地图编辑说"
      }
    },
    "/api/app/cities/{id}": {
      "get": {
        "summary": "App 城市详情（仅上架城市，字段同列表项；不存在或未上架返回 404）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-requirement": "city/地图编辑说"
      }
    },
    "/api/app/merchants/page": {
      "get": {
        "summary": "App 商户列表分页（cityId 必填；period / categoryId 可选；固定 weight DESC, createdAt DESC，不受推荐清单影响）",
        "parameters": [
          {
            "name": "cityId",
            "in": "query",
            "required": true,
            "description": "城市 ID，必填",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "生理周期，可选",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "description": "分类 ID，可选",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，从 1 开始，默认 1",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 20",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "x-requirement": "recommend-list/App 端清单与清单内商户查询"
      }
    },
    "/api/app/merchants/{id}": {
      "get": {
        "summary": "App 商户详情（响应新增 recommendReason）",
        "x-requirement": "merchant/商户编辑推荐理由"
      }
    },
    "/api/admin/recommend-lists/page": {
      "get": {
        "summary": "推荐清单分页列表，支持 cityId/keyword 过滤，sortOrder 升序",
        "parameters": [
          {
            "name": "cityId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "x-requirement": "recommend-list/推荐清单管理"
      }
    },
    "/api/admin/recommend-lists": {
      "post": {
        "summary": "创建推荐清单（可带 status / merchantIds，merchantIds 顺序即清单保存顺序）",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendListCreateRequest"
              }
            }
          }
        },
        "x-requirement": "recommend-list/推荐清单管理"
      }
    },
    "/api/admin/recommend-lists/{id}": {
      "get": {
        "summary": "清单详情（含商户明细，按清单保存顺序）",
        "x-requirement": "recommend-list/推荐清单管理"
      },
      "put": {
        "summary": "更新清单（cityId/status 可变；merchantIds 非 null 时整体替换，顺序即清单保存顺序）",
        "x-requirement": "recommend-list/推荐清单管理",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendListUpdateRequest"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "物理删除清单（同事务删除商户关联）",
        "x-requirement": "recommend-list/推荐清单管理"
      }
    },
    "/api/admin/recommend-lists/{id}/online": {
      "post": {
        "summary": "人工恢复清单为 ONLINE；清单内存在已下架商户 → 400；已是 ONLINE 幂等返回详情",
        "x-requirement": "recommend-list/推荐清单管理"
      }
    },
    "/api/app/recommend-lists": {
      "get": {
        "summary": "App 按城市查询清单列表（仅上架城市，sortOrder 升序、同序号 createdAt 倒序）",
        "parameters": [
          {
            "name": "cityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-requirement": "recommend-list/App 端清单与清单内商户查询"
      }
    },
    "/api/app/recommend-lists/{id}": {
      "get": {
        "summary": "App 清单详情含商户（按清单保存顺序，同序号 createdAt 倒序；商户项仅 id/name/address/logo；所属城市下架 → 404）",
        "x-requirement": "recommend-list/App 端清单与清单内商户查询"
      }
    },
    "/api/admin/ambassadors/page": {
      "get": {
        "summary": "爱女大使分页列表，支持 keyword 过滤",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "x-requirement": "route/爱女大使管理"
      }
    },
    "/api/admin/ambassadors": {
      "post": {
        "summary": "创建爱女大使",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AmbassadorUpsertRequest"
              }
            }
          }
        },
        "x-requirement": "route/爱女大使管理"
      }
    },
    "/api/admin/ambassadors/{id}": {
      "get": {
        "summary": "大使详情",
        "x-requirement": "route/爱女大使管理"
      },
      "put": {
        "summary": "更新大使",
        "x-requirement": "route/爱女大使管理"
      },
      "delete": {
        "summary": "物理删除大使",
        "x-requirement": "route/爱女大使管理"
      }
    },
    "/api/admin/ambassadors/{id}/online": {
      "put": {
        "summary": "大使上下线 {online}；下线后其关联路线 app 端整体隐藏",
        "x-requirement": "route/爱女大使管理"
      }
    },
    "/api/app/ambassadors": {
      "get": {
        "summary": "App 爱女大使列表：仅上线大使，weight DESC + createdAt DESC，limit 条（默认 3，最大 20，非法值回落默认）",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3,
              "maximum": 20
            }
          }
        ],
        "x-requirement": "route/爱女大使管理"
      }
    },
    "/api/app/ambassadors/{id}": {
      "get": {
        "summary": "App 爱女大使详情（仅上线大使；下线或不存在返回 404）",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-requirement": "route/爱女大使管理"
      }
    },
    "/api/admin/routes/page": {
      "get": {
        "summary": "路线分页列表，支持 cityId/keyword 过滤，sortOrder 升序",
        "parameters": [
          {
            "name": "cityId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "x-requirement": "route/路线管理"
      }
    },
    "/api/admin/routes": {
      "post": {
        "summary": "创建路线（含地点列表，按提交顺序保存）",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteUpsertRequest"
              }
            }
          }
        },
        "x-requirement": "route/路线管理"
      }
    },
    "/api/admin/routes/{id}": {
      "get": {
        "summary": "路线详情（含地点列表）",
        "x-requirement": "route/路线管理"
      },
      "put": {
        "summary": "更新路线（cityId 不可变）",
        "x-requirement": "route/路线管理"
      },
      "delete": {
        "summary": "物理删除路线（连带地点）",
        "x-requirement": "route/路线管理"
      }
    },
    "/api/app/routes": {
      "get": {
        "summary": "App 查询路线列表（cityName / ambassadorId 均可选；仅大使上线即可见，城市上架与否不影响，sortOrder 升序、同序号 createdAt 倒序）；列表项含 cityName（路线自身城市名，与详情同源，未填为 null）与 ambassadorNote（爱女大使说，未填为 null）",
        "parameters": [
          {
            "name": "cityName",
            "in": "query",
            "required": false,
            "description": "城市中文名，可选；与路线上的城市名原样匹配，不做城市库校验；城市表中无同名城市时该路线的 city 为 null",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ambassadorId",
            "in": "query",
            "required": false,
            "description": "爱女大使 ID，可选；不传则不按大使过滤",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-requirement": "route/App 端路线查询"
      }
    },
    "/api/app/routes/{id}": {
      "get": {
        "summary": "App 路线详情含地点、大使信息（ambassador 对象含 id / name / avatar / tags）与所属城市名 cityName（城市记录已删除时为 null；大使下线 → 404，城市下架不影响）",
        "x-requirement": "route/App 端路线查询"
      }
    },
    "/api/admin/activities/page": {
      "get": {
        "summary": "活动分页列表，支持 keyword 过滤",
