      }
    },
    "/api/app/activities": {
      "get": {
        "summary": "App 活动列表（全部上线活动，列表项含 subtitle 副标题（未填为 null，不回落为 title），创建时间倒序；与地图无关）",
        "x-requirement": "activity/App 端活动查询"
