            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "内容类型，可选；不传则下发全部类型，非法值返回 400",
            "schema": {
              "$ref": "#/components/schemas/FeaturedCycleItemType"
            }
          }
        ],
        "x-requirement": "featured/App 端周期推荐查询"
      }
    },
