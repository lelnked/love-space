  "components": {
    "schemas": {
      "RecommendListCreateRequest": {
        "type": "object",
        "required": [
          "title",
          "cityId"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "清单标题，必填"
          },
          "introduction": {
            "type": "string",
            "description": "清单介绍"
          },
          "cityId": {
            "type": "string",
            "format": "uuid",
            "description": "所属城市，创建后不可变"
          },
          "sortOrder": {
            "type": "integer",
            "default": 0,
            "description": "清单间排序，升序"
          }
        }
      },
      "RecommendListMerchantItem": {
        "type": "object",
        "required": [
          "merchantId",
          "sortOrder"
        ],
        "properties": {
          "merchantId": {
            "type": "string",
            "format": "uuid"
          },
          "sortOrder": {
            "type": "integer",
            "description": "清单内商户排序，升序"
          }
        }
      },
      "AmbassadorUpsertRequest": {
        "type": "object",
        "required": [
          "avatar",
          "name"
        ],
        "properties": {
          "avatar": {
            "type": "string",
            "description": "头像 objectKey，1 张，必填"
          },
          "name": {
            "type": "string",
            "description": "大使名称，必填"
          },
          "tags": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "description": "标签，最多 3 条"
          },
          "online": {
            "type": "boolean",
