  "components": {
    "schemas": {
      "RecommendListCreateRequest": {
        "type": "object",
        "required": [
          "title",
          "cityId"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "清单标题，必填"
          },
          "introduction": {
            "type": "string",
            "description": "清单介绍"
          },
          "cityId": {
            "type": "string",
            "format": "uuid",
            "description": "所属城市，创建后不可变"
          },
          "sortOrder": {
            "type": "integer",
            "default": 0,
            "description": "清单间排序，升序"
          },
          "status": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE"
            ],
            "default": "ONLINE",
            "description": "上架状态，可空，默认 ONLINE"
          },
          "merchantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "清单内商户 ID，有序；数组顺序即清单保存顺序。校验：存在、属于清单所属城市、未下架、不重复"
          }
        }
      },
      "AmbassadorUpsertRequest": {
        "type": "object",
        "required": [
          "avatar",
          "name"
        ],
        "properties": {
          "avatar": {
            "type": "string",
            "description": "头像 objectKey，1 张，必填"
          },
          "name": {
            "type": "string",
            "description": "大使名称，必填"
          },
          "tags": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "description": "标签，最多 3 条"
          },
          "weight": {
            "type": "integer",
            "description": "排序权重，默认 0；app 端列表按其倒序取前 N 条"
          },
          "online": {
            "type": "boolean",
            "description": "上线/下线"
          }
        }
      },
      "RouteSpot": {
        "type": "object",
        "required": [
          "name",
          "image",
          "introduction"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "地点名称"
          },
          "image": {
            "type": "string",
            "description": "地点图片 objectKey，1 张"
          },
          "introduction": {
            "type": "string",
            "description": "地点介绍"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "description": "地点地址，可空；未填时为 null"
          }
        }
      },
      "RouteUpsertRequest": {
        "type": "object",
        "required": [
          "cityId",
          "title",
          "thumbnail",
          "images",
          "ambassadorId"
        ],
        "properties": {
          "cityId": {
            "type": "string",
            "format": "uuid",
            "description": "所属地图（城市），创建后不可变"
          },
          "sortOrder": {
            "type": "integer",
            "default": 0,
            "description": "路线间排序，升序"
          },
          "title": {
            "type": "string",
            "description": "主标题，必填"
          },
          "ambassadorNote": {
            "type": "string",
            "description": "爱女大使说"
          },
          "thumbnail": {
            "type": "string",
            "description": "缩略图 objectKey，1 张，必填"
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "路线图片 objectKey，≥1 张"
          },
          "travelTime": {
            "type": "string",
            "description": "旅行时间，文本"
          },
          "season": {
            "type": "string",
            "description": "适合季节，文本"
          },
          "travelStatus": {
            "type": "string",
            "description": "旅行状态，文本"
          },
          "ambassadorId": {
            "type": "string",
            "format": "uuid",
            "description": "关联爱女大使，必填单选"
          },
          "spots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteSpot"
            },
            "description": "地点列表，按添加顺序"
          }
        }
      },
      "ActivityItineraryItem": {
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "如 Day1"
          },
          "content": {
            "type": "string",
            "description": "如 到成都天府机场集合"
          }
        }
      },
      "ActivityUpsertRequest": {
        "type": "object",
        "required": [
          "title",
          "images"
        ],
        "properties": {
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "活动图片 objectKey，≥1 张"
          },
          "title": {
            "type": "string",
            "description": "活动标题，必填"
          },
          "subtitle": {
            "type": "string",
            "description": "活动副标题，可空"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "活动标签，多个"
          },
          "periods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MENSTRUAL",
                "FOLLICULAR",
                "OVULATION",
                "LUTEAL"
              ]
            },
            "description": "适合周期，多选"
          },
          "level": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3"
            ],
            "description": "活动级别，单选"
          },
          "introduction": {
            "type": "string",
            "description": "活动简介"
          },
          "editorNote": {
            "type": "string",
            "description": "编辑说"
          },
          "gatheringPlace": {
            "type": "string",
            "description": "集合地"
          },
          "dismissalPlace": {
            "type": "string",
            "description": "解散地"
          },
          "transportation": {
            "type": "string",
            "description": "交通"
          },
          "visa": {
            "type": "string",
            "description": "签证"
          },
          "landscape": {
            "type": "string",
            "description": "景观"
          },
          "itinerary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityItineraryItem"
            },
            "description": "路线子条目，按添加顺序"
          },
          "detailHtml": {
            "type": "string",
            "description": "活动详情说明，富文本 HTML；img src 存 objectKey"
          },
          "online": {
            "type": "boolean",
            "description": "上线/下线"
          }
        }
      },
      "ArticleCategoryUpsertRequest": {
        "type": "object",
        "required": [
          "name",
          "icon"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "description": "objectKey"
          },
          "sortOrder": {
            "type": "integer"
          }
        }
      },
      "ArticleUpsertRequest": {
        "type": "object",
        "required": [
          "image",
          "title"
        ],
        "properties": {
          "image": {
            "type": "string",
            "description": "objectKey"
          },
          "title": {
            "type": "string",
            "description": "文章标题，详情页展示"
          },
          "coverTitle": {
            "type": "string",
            "description": "封面标题，列表/封面展示；可空，app 列表为空时回落 title"
          },
          "subtitle": {
            "type": "string"
          },
          "intro": {
            "type": "string",
            "description": "文章引言，详情页导语；可空"
          },
          "tags": {
            "type": "array",
            "description": "文章标签，自由文本；可空，空白项写入时剔除",
            "items": {
              "type": "string"
            }
          },
          "contentHtml": {
            "type": "string",
            "description": "富文本 HTML，img src 为 objectKey"
          },
          "sortOrder": {
            "type": "integer"
          },
          "categoryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "online": {
            "type": "boolean"
          }
        }
      },
      "FeaturedItemUpsertRequest": {
        "type": "object",
        "required": [
          "cityId",
          "banner"
        ],
        "properties": {
          "cityId": {
            "type": "string",
            "format": "uuid"
          },
          "banner": {
            "type": "string",
            "description": "objectKey，比例不校验"
          },
          "description": {
            "type": "string"
          },
          "online": {
            "type": "boolean"
          }
        }
      },
      "FeaturedCycleItemType": {
        "type": "string",
        "enum": [
          "ACTIVITY",
          "ROUTE",
          "ARTICLE"
        ],
        "description": "tripperclub活动/路线体验/周期生活法"
      },
      "FeaturedCycleItemUpsertRequest": {
        "type": "object",
        "required": [
          "phases",
          "type",
          "banner",
          "targetId"
        ],
        "description": "宽 record：文案字段的必填性按 type 在服务端分派校验；不属于该 type 的文案字段被忽略且不落库。(type,targetId) 全局唯一，重复返回 400",
        "properties": {
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Period"
            },
            "description": "投放周期集合，至少一个；创建后可修改；服务端去重并按枚举声明顺序落库"
          },
          "type": {
            "$ref": "#/components/schemas/FeaturedCycleItemType"
          },
          "banner": {
            "type": "string",
            "description": "objectKey，比例不校验"
          },
          "sortOrder": {
            "type": "integer",
            "default": 0
          },
          "online": {
            "type": "boolean",
            "default": false
          },
          "targetId": {
            "type": "string",
            "format": "uuid",
            "description": "关联实体 id，指向哪类实体由 type 判别（ACTIVITY→活动 / ROUTE→路线 / ARTICLE→文章）；必填，按 type 分派到对应实体校验存在性；创建后可修改，改动后原实体的唯一位释放"
          },
          "title": {
            "type": "string",
            "description": "type=ROUTE 主标题必填；type=ARTICLE 主标题必填"
          },
          "subtitle": {
            "type": "string",
            "description": "type=ROUTE 副标题必填"
          },
          "description": {
            "type": "string",
            "description": "推荐说明；type=ACTIVITY/ROUTE 必填"
          },
          "note": {
            "type": "string",
            "description": "活动说明；type=ACTIVITY 选填"
          }
        }
      },
      "Period": {
        "type": "string",
        "enum": [
          "MENSTRUAL",
          "FOLLICULAR",
          "OVULATION",
          "LUTEAL"
        ],
        "description": "生理周期：经期/卵泡期/排卵期/黄体期（复用既有 common/enums/Period）"
      },
      "RecommendListUpdateRequest": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "清单标题，必填"
          },
          "introduction": {
            "type": "string",
            "description": "清单介绍"
          },
          "cityId": {
            "type": "string",
            "format": "uuid",
            "description": "所属城市，可改；null 视为不修改。改城市时清单内已有商户须全部属于新城市，否则 400"
          },
          "sortOrder": {
            "type": "integer",
            "description": "清单间排序，升序；null 视为 0"
          },
          "status": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE"
            ],
            "description": "上架状态；null 视为不修改"
          },
          "merchantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "清单内商户 ID，有序；null 视为不修改，非 null 整体替换，数组顺序即清单保存顺序。校验同创建"
          }
        }
      }
    }
  }
}
