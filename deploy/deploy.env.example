# love-space 部署配置示例。
# 用法：cp deploy.env.example deploy.env，按需修改后再跑各脚本。
# 各 deploy-*.sh 会自动 source 同目录下的 deploy.env（存在时）。

# ===== 通用 =====
# 容器互联用的 docker 网络名（脚本会自动创建）。
NETWORK=love-space-net
# 宿主机日志根目录；admin/app 日志分别挂到 $LOG_BASE_DIR/admin、$LOG_BASE_DIR/app。
LOG_BASE_DIR=/opt/love-space/logs
# 容器重启策略：unless-stopped 可随 docker 守护进程开机自启（满足“自己启动”要求）。
RESTART_POLICY=unless-stopped

# ===== PostgreSQL =====
PG_IMAGE=postgres:17
PG_CONTAINER=love-space-postgres
PG_DB=love_space
PG_USER=love_space
PG_PASSWORD=love_space
# 宿主机映射端口（仅本机访问，调试用）；不想对外暴露可留空跳过映射。
PG_HOST_PORT=5432
# 数据卷名（命名卷，删容器不丢数据）。
PG_VOLUME=love-space-pgdata

# ===== admin 后端 =====
# 镜像名（不含 tag）；tag 由部署脚本的版本入参指定，最终镜像为 ADMIN_IMAGE_NAME:版本。
ADMIN_IMAGE_NAME=love-space-admin
ADMIN_CONTAINER=love-space-admin
ADMIN_HOST_PORT=8080
ADMIN_JWT_SECRET=please-replace-with-a-256-bit-base64-secret-please-replace

# ===== app 后端 =====
# 镜像名（不含 tag）；tag 由部署脚本的版本入参指定，最终镜像为 APP_IMAGE_NAME:版本。
APP_IMAGE_NAME=love-space-app
APP_CONTAINER=love-space-app
APP_HOST_PORT=8081
# 多个 key 用英文逗号分隔。
APP_SECURITY_API_KEYS=dev-app-api-key-please-rotate

# ===== 阿里云 OSS（admin 与 app 共用）=====
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# admin 专用 STS（如使用 STS 直传）
ALIYUN_STS_ROLE_ARN=
