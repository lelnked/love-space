# 部署环境变量模板。复制成 .env.prod / .env.test 后按环境填值（.env.* 已被 .gitignore 忽略）。
# 用法：DEPLOY_ENV=prod bash deploy-all.sh 1.2.0
# 写法一律 X="${X:-值}"：shell 里已存在的同名变量优先（服务器 ~/.bashrc 注入的敏感值不会被覆盖）。
# 只需要写与默认值不同的项，其余留着或删掉都行——脚本里都有默认值。

# ===== PostgreSQL =====
PG_DB="${PG_DB:-love_space}"
PG_USER="${PG_USER:-love_space}"
PG_PASSWORD="${PG_PASSWORD:-love_space}"
PG_HOST_PORT="${PG_HOST_PORT:-8954}"          # 宿主机映射端口
PG_CONTAINER="${PG_CONTAINER:-love-space-postgres}"
PG_BASE_DIR="${PG_BASE_DIR:-/app/loveSpace/pgdata}"

# 后端连库地址（宿主机 IP:端口，不要写 localhost——host 网络下也可以，但保持与现网一致）
DB_HOST="${DB_HOST:-172.26.150.96}"
DB_PORT="${DB_PORT:-8954}"

# ===== admin 后端 =====
ADMIN_CONTAINER="${ADMIN_CONTAINER:-love-space-admin}"
ADMIN_HOST_PORT="${ADMIN_HOST_PORT:-8080}"
ADMIN_JWT_SECRET="${ADMIN_JWT_SECRET:-}"      # openssl rand -base64 32

# ===== app 后端 =====
APP_CONTAINER="${APP_CONTAINER:-love-space-app}"
APP_HOST_PORT="${APP_HOST_PORT:-8081}"
APP_SECURITY_API_KEYS="${APP_SECURITY_API_KEYS:-}"   # openssl rand -hex 32；多 key 逗号分隔

# ===== 阿里云 OSS（admin 与 app 共用）=====
ALIYUN_OSS_REGION="${ALIYUN_OSS_REGION:-}"
ALIYUN_OSS_ENDPOINT="${ALIYUN_OSS_ENDPOINT:-}"
ALIYUN_OSS_BUCKET="${ALIYUN_OSS_BUCKET:-}"
ALIYUN_OSS_ACCESS_KEY_ID="${ALIYUN_OSS_ACCESS_KEY_ID:-}"
ALIYUN_OSS_ACCESS_KEY_SECRET="${ALIYUN_OSS_ACCESS_KEY_SECRET:-}"
ALIYUN_STS_ROLE_ARN="${ALIYUN_STS_ROLE_ARN:-}"

# ===== 其它（一般不用改）=====
LOG_BASE_DIR="${LOG_BASE_DIR:-/app/loveSpace/logs}"
JVM_MAX_HEAP="${JVM_MAX_HEAP:-1000m}"
